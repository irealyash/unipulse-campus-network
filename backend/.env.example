# ------------------------------------------------------------------
# UniPulse backend environment variables
# Copy this file to ".env" and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Port the Express/Socket.io server listens on (Railway sets PORT automatically)
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/unipulse?retryWrites=true&w=majority

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET=replace_with_a_long_random_secret
# How long an auth token stays valid
JWT_EXPIRES_IN=30d

# Secret mixed into the OTP hash (extra protection if the DB leaks)
OTP_SECRET=replace_with_another_long_random_secret
# OTP lifetime in minutes
OTP_TTL_MINUTES=10

# Only emails ending in this domain are accepted at signup
# (moderator emails in MODERATOR_EMAILS may bypass this)
ALLOWED_EMAIL_DOMAIN=@student.ubc.ca

# Frontend origin(s) allowed by CORS — comma-separated for apex + www
# Local:  http://localhost:5173
# Prod:   https://unipulse.live,https://www.unipulse.live
CLIENT_URL=http://localhost:5173

# Comma-separated emails auto-granted moderator powers on verify/login
# MODERATOR_EMAILS=you@example.com

# Set to true once on first deploy to seed default general communities.
# Leave unset so moderator deletes are not restored on every restart.
# SEED_DEFAULT_COMMUNITIES=true

# Cloudinary (image/video uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (transactional email for OTP + password reset)
RESEND_API_KEY=re_xxxxxxxx
# From address — must use a domain verified in Resend
MAIL_FROM=UniPulse <no-reply@unipulse.live>
