# ------------------------------------------------------------------
# UniPulse backend environment variables
# Copy this file to ".env" and fill in real values. Never commit .env.
# ------------------------------------------------------------------

# Port the Express/Socket.io server listens on
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb+srv://irealyash:yash6363@cluster0.5pxek5u.mongodb.net/

# Secret used to sign JWT auth tokens. Use a long random string.
JWT_SECRET=replace_with_a_long_random_secret
# How long an auth token stays valid
JWT_EXPIRES_IN=30d

# Secret mixed into the OTP hash (extra protection if the DB leaks)
OTP_SECRET=replace_with_another_long_random_secret
# OTP lifetime in minutes
OTP_TTL_MINUTES=10

# Only emails ending in this domain are accepted as valid UBC students
ALLOWED_EMAIL_DOMAIN=@student.ubc.ca

# Frontend origin allowed by CORS (the Vite dev server by default)
CLIENT_URL=http://localhost:5173

# Comma-separated emails auto-granted moderator powers (exempt from the domain
# rule). e.g. MODERATOR_EMAILS=iyash636@student.ubc.ca
MODERATOR_EMAILS=

# ---- Nodemailer (SMTP) settings used to send verification codes ----
# For Gmail use an "App Password", not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# The "From" name/address shown to recipients
MAIL_FROM="UniPulse <your_email@gmail.com>"
