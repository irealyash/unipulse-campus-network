# ------------------------------------------------------------------
# UniPulse frontend environment variables (Vite)
# Copy to ".env" / ".env.local" for local, or set in Vercel Project Settings.
# Only vars prefixed with VITE_ are exposed to the browser.
# ------------------------------------------------------------------

# Giphy API key for the chat GIF picker (create at https://developers.giphy.com)
VITE_GIPHY_API_KEY=your_giphy_api_key

# Backend origin — REQUIRED in production (Railway URL, no trailing slash).
# Leave EMPTY for local Vite dev (requests use /api proxy → localhost:5000).
# Example: VITE_API_URL=https://unipulse-api.up.railway.app
# VITE_API_URL=
